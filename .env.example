# Copia a .env en local (no subas .env a git). En Railway configura estas variables en el panel.

# MySQL (en Railway referencia el plugin con ${{NombreServicio.VARIABLE}})
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Auth0 / Google (opcional)
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# AUTH0_CONNECTION=google-oauth2
# AUTH0_REDIRECT_URI=https://TU_DOMINIO/index.php?page=auth_google_callback
